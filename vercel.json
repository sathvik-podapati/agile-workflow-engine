{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agile-workflow-engine.onrender.com/api/:path*"
    },
    {
      "source": "/ws-updates",
      "destination": "https://agile-workflow-engine.onrender.com/ws-updates"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

